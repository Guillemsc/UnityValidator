<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="validator-entry-row" class="validator-entry-row" style="flex-direction: row; align-items: center; min-height: 22px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-shrink: 0;">
        <ui:Toggle name="validator-toggle" value="true" class="validator-toggle" style="width: 16px; flex-shrink: 0; margin-right: 0; margin-left: 5px; align-items: center; justify-content: center; margin-bottom: 0; margin-top: 0;" />
        <ui:Label name="validator-name" text="Validator" class="validator-name" style="flex-grow: 1; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding-left: 0; padding-right: 0; margin-left: 4px; margin-right: 5px;" />
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="validation-object-cell" class="validation-object-cell" style="flex-direction: row; align-items: center; flex-grow: 1; min-width: 0; height: 22px; padding-left: 5px; padding-right: 5px; border-left-width: 1px;">
        <ui:VisualElement name="object-icon" class="validation-object-icon" style="display: none; width: 16px; height: 16px; flex-shrink: 0; margin-right: 4px;" />
        <ui:Label name="object-name" class="validation-object-name" style="min-width: 0; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;" />
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="gvalidator-window" class="gvalidator-window" style="flex-grow: 1;">
        <uie:Toolbar name="window-toolbar" class="window-toolbar">
            <uie:ToolbarButton name="run-all-button" text="Run All" class="unity-toolbar-button toolbar-button"/>
            <uie:ToolbarButton name="clear-results-button" text="Clear" class="unity-toolbar-button toolbar-button"/>
            <uie:ToolbarButton name="global-configuration-button" text="Global Configuration" tooltip="Create or locate the global GValidator configuration" class="unity-toolbar-button toolbar-button"/>
            <ui:VisualElement style="flex-direction: row; align-items: center; align-self: center;">
                <ui:Label text="Scope:" style="margin-left: 4px; margin-right: 4px; -unity-text-align: middle-left;"/>
                <ui:Image name="search-scope-icon" style="width: 16px; height: 16px; margin-right: 3px; align-self: center;"/>
                <ui:Label name="search-scope-label" text="Assets/" tooltip="Assets/" style="min-width: 50px; flex-shrink: 0; white-space: nowrap; text-overflow: clip; margin-right: 8px; -unity-text-align: middle-left;"/>
                <uie:ToolbarButton name="run-scoped-button" text="Run Scoped" tooltip="Run validation for the current scope" style="display: none;"/>
                <uie:ToolbarButton name="clear-search-scope-button" text="Clear Scope" tooltip="Clear the current scope" style="display: none;"/>
            </ui:VisualElement>
            <uie:ToolbarSpacer class="toolbar-spacer" style="flex-grow: 1; flex-shrink: 0; flex-basis: auto;"/>
            <ui:VisualElement name="severity-filters" class="unity-toolbar-toggle-group severity-filters" style="flex-direction: row; width: auto; min-width: 0; flex: 0 0 auto; align-items: center;">
                <uie:ToolbarToggle name="info-toggle" text="0" tooltip="Show or hide info messages" value="true" class="unity-toolbar-toggle severity-toggle severity-toggle-info" style="width: auto; min-width: 0; flex: 0 0 auto; padding-left: 20px; padding-right: 4px; background-image: resource(&quot;console.infoicon.sml&quot;); background-size: 16px 16px; background-position-x: 4px; background-position-y: center; background-repeat: no-repeat;"/>
                <uie:ToolbarToggle name="warning-toggle" text="0" tooltip="Show or hide warnings" value="true" class="unity-toolbar-toggle severity-toggle severity-toggle-warning" style="width: auto; min-width: 0; flex: 0 0 auto; padding-left: 20px; padding-right: 4px; background-image: resource(&quot;console.warnicon.sml&quot;); background-size: 16px 16px; background-position-x: 4px; background-position-y: center; background-repeat: no-repeat;"/>
                <uie:ToolbarToggle name="error-toggle" text="0" tooltip="Show or hide errors" value="true" class="unity-toolbar-toggle severity-toggle severity-toggle-error" style="width: auto; min-width: 0; flex: 0 0 auto; padding-left: 20px; padding-right: 4px; background-image: resource(&quot;console.erroricon.sml&quot;); background-size: 16px 16px; background-position-x: 4px; background-position-y: center; background-repeat: no-repeat;"/>
            </ui:VisualElement>
        </uie:Toolbar>
        <ui:TwoPaneSplitView name="content-split" fixed-pane-index="0" fixed-pane-initial-dimension="280" orientation="Horizontal" class="content-split" style="flex-grow: 1; min-width: 0;">
            <ui:VisualElement name="validator-pane" class="validator-pane" style="min-width: 180px; overflow: hidden;">
                <uie:Toolbar>
                    <ui:Label text="Sources" class="pane-title" style="-unity-text-align: middle-left; margin-left: 5px; margin-right: 5px;"/>
                </uie:Toolbar>
                <uie:Toolbar style="width: auto;">
                    <uie:ToolbarButton name="select-all-scenes-button" text="Select Scenes" tooltip="Select all scene sources" style="flex-grow: 1;"/>
                    <uie:ToolbarButton name="deselect-all-scenes-button" text="Deselect Scenes" tooltip="Deselect all scene sources" style="flex-grow: 1; padding-right: 0; margin-right: -1px;"/>
                </uie:Toolbar>
                <ui:VisualElement class="sources-content" style="flex-grow: 1; min-width: 0; min-height: 0; overflow: hidden; padding: 6px; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0;">
                    <ui:ScrollView name="source-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="source-list" style="min-width: 0; min-height: 0; overflow: hidden; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;">
                        <ui:Label name="source-list-empty" text="No sources available." class="empty-state" style="min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: clip; margin-left: 5px; margin-right: 5px; padding-right: 0; padding-left: 0;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
                <uie:Toolbar style="border-top-width: 1px;">
                    <ui:Label text="Validators" class="pane-title" style="-unity-text-align: middle-left; margin-left: 5px; margin-right: 5px;"/>
                </uie:Toolbar>
                <ui:VisualElement class="validators-content" style="flex-grow: 1; min-width: 0; min-height: 0; overflow: hidden; padding: 6px; padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; margin-bottom: 5px; margin-top: 0;">
                    <ui:ScrollView name="validator-list" class="validator-list" style="min-width: 0; min-height: 0; overflow: hidden;">
                        <ui:Label name="validator-list-empty" text="No validators discovered." class="empty-state" style="min-width: 0; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: clip; margin-left: 5px; margin-right: 5px; padding-right: 0; padding-left: 0;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="results-pane" class="results-pane" style="min-width: 0; overflow: hidden;">
                <ui:VisualElement class="results-content" style="flex-grow: 1; min-width: 0; overflow: hidden; padding: 6px; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0;">
                    <ui:TwoPaneSplitView name="results-detail-split" view-data-key="gvalidator-results-detail-split" fixed-pane-index="1" fixed-pane-initial-dimension="166" orientation="Vertical" class="results-detail-split" style="flex-grow: 1;">
                        <ui:MultiColumnListView name="results-list" fixed-item-height="22" virtualization-method="FixedHeight" show-alternating-row-backgrounds="ContentOnly" selection-type="Single" class="results-list" style="flex-grow: 1; min-width: 0; margin-top: 0; margin-bottom: 5px;"/>
                        <ui:VisualElement name="detail-panel" class="detail-panel" style="margin-top: 5px; margin-bottom: 5px;">
                            <ui:TwoPaneSplitView name="detail-content-split" view-data-key="gvalidator-detail-content-split" fixed-pane-index="1" fixed-pane-initial-dimension="250" orientation="Horizontal" style="flex-grow: 1; min-width: 0;">
                                <ui:ScrollView name="detail-message-scroll" class="detail-message-scroll">
                                    <ui:Label name="detail-message-label" class="detail-message" selectable="true" style="min-width: 0; white-space: normal; overflow: hidden; padding-left: 0; padding-right: 0; margin-left: 5px; margin-right: 5px;"/>
                                </ui:ScrollView>
                                <ui:ScrollView name="detail-metadata-scroll" style="min-width: 0;">
                                    <ui:VisualElement name="detail-metadata-panel" style="padding-left: 8px; padding-right: 8px; padding-top: 4px;">
                                        <ui:Label text="Validator" style="-unity-font-style: bold; margin-bottom: 2px;"/>
                                        <ui:Label name="detail-validator-name" text="—" selectable="true" style="white-space: normal; margin-bottom: 8px;"/>
                                        <ui:Label text="Object Path" style="-unity-font-style: bold; margin-bottom: 2px;"/>
                                        <ui:Label name="detail-object-path" text="—" selectable="true" style="white-space: normal;"/>
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:TwoPaneSplitView>
                        </ui:VisualElement>
                    </ui:TwoPaneSplitView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="validation-message-row" class="validation-message-row" style="flex-direction: row; align-items: center; min-height: 22px; padding-left: 5px; padding-right: 5px; padding-top: 2px; padding-bottom: 2px; flex-shrink: 0;">
        <ui:VisualElement name="message-icon" class="validation-message-icon" style="width: 16px; height: 16px; flex-shrink: 0; margin-right: 4px; margin-left: 0;" />
        <ui:Label name="message-text" text="Message" class="validation-message-text" style="flex-grow: 1; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding-left: 0; padding-right: 0; margin-left: 0; margin-right: 5px;" />
    </ui:VisualElement>
</ui:UXML>
